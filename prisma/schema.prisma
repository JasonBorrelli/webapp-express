// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Game {
  id          Int      @id @default(autoincrement())                                  // campo id, chiave primaria, autoincrementale
  name        String                                                                  // campo name, tipo stringa  
  description String?                                                                     // campo description, tipo stringa, opzionale
  price       Float                                                                   // campo price, tipo float
  categoryId  Int                                                                     //  foreign key categoryId, tipo intero
  category    Category @relation(fields: [categoryId], references: [id])                 // relazione con la tabella category fields: [categoryId], references: [id]
  createdAt   DateTime @default(now())                                                    // campo createdAt, tipo DateTime, con valore di default
  updatedAt   DateTime @updatedAt                                                     // campo updatedAt, tipo DateTime, con aggiornamento automatico
}

model Category {
  id          Int      @id @default(autoincrement())                                  // campo id, chiave primaria, autoincrementale
  name        String   @unique                                                         // campo name, tipo stringa, univoco
  description String?                                                                     // campo description, tipo stringa, opzionale
  games       Game[]                                                                      // relazione con la tabella game
  createdAt   DateTime @default(now())                                                    // campo createdAt, tipo DateTime, con valore di default
  updatedAt   DateTime @updatedAt                                                     // campo updatedAt, tipo DateTime, con aggiornamento automatico
}

